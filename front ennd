<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AI Story Generator</title>
  <link rel="stylesheet" href="style.css"/>
</head>
<body>
  <div class="container">
    <h1>AI Story Generator</h1>
    <textarea id="promptInput" placeholder="Enter your story idea here..."></textarea>
    <button id="generateBtn">Generate Story</button>
    <div id="loading" style="display:none;">Generating story...</div>
    <div id="storyOutput"></div>
  </div>
  <script src="script.js"></script>
</body>
</html>

body {
  font-family: Arial, sans-serif;
  background: #f5f5f5;
  padding: 2rem;
  margin: 0;
}

.container {
  max-width: 700px;
  margin: auto;
  background: white;
  padding: 2rem;
  border-radius: 8px;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

textarea {
  width: 100%;
  height: 100px;
  margin-bottom: 1rem;
  padding: 0.75rem;
  font-size: 1rem;
}

button {
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  background-color: #007BFF;
  border: none;
  color: white;
  cursor: pointer;
  border-radius: 4px;
}

#storyOutput {
  margin-top: 2rem;
  white-space: pre-wrap;
  background: #fafafa;
  padding: 1rem;
  border-radius: 4px;
  border: 1px solid #ccc;
}

#loading {
  margin-top: 1rem;
  font-style: italic;
}

document.getElementById('generateBtn').addEventListener('click', async () => {
  const prompt = document.getElementById('promptInput').value;
  const storyOutput = document.getElementById('storyOutput');
  const loading = document.getElementById('loading');

  if (!prompt.trim()) {
    alert("Please enter a story prompt.");
    return;
  }

  storyOutput.textContent = "";
  loading.style.display = "block";

  try {
    const response = await fetch('/api/generate-story', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ prompt })
    });

    const data = await response.json();
    storyOutput.textContent = data.story || "No story returned.";
  } catch (error) {
    storyOutput.textContent = "Error generating story.";
    console.error(error);
  } finally {
    loading.style.display = "none";
  }
});

